# Environment for running the API or worker on the host against deploy/compose.dev.yml
# (make run-api / make run-worker). Dev-only dummy values; nothing here is a real secret.
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://analyzer:change-me-dev-only@127.0.0.1:5432/analyzer
CELERY_BROKER_URL=amqp://analyzer:change-me-dev-only@127.0.0.1:5672//
S3_BUCKET=experiment-analyzer-dev
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://127.0.0.1:5000
S3_PUBLIC_ENDPOINT_URL=http://localhost:5000
S3_CREATE_BUCKET=true
AWS_ACCESS_KEY_ID=testing
AWS_SECRET_ACCESS_KEY=testing
GIT_SHA=dev
