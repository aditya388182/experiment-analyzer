# Copy to .env for `make dev`. Never commit .env. In Kubernetes these come from a ConfigMap and a Secret.

# Django
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL 16
POSTGRES_DB=analyzer
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=change-me-dev-only
DATABASE_URL=postgres://analyzer:change-me-dev-only@postgres:5432/analyzer

# RabbitMQ (Celery broker)
RABBITMQ_DEFAULT_USER=analyzer
RABBITMQ_DEFAULT_PASS=change-me-dev-only
CELERY_BROKER_URL=amqp://analyzer:change-me-dev-only@rabbitmq:5672//

# S3. In dev this points at moto. In prod leave the endpoint vars empty and the
# EC2 instance role supplies credentials (no keys in the cluster).
S3_BUCKET=experiment-analyzer-dev
AWS_REGION=us-east-1
# Endpoint the API/worker use (inside the Compose network)
S3_ENDPOINT_URL=http://moto:5000
# Endpoint the browser posts to (presigned POST URL host)
S3_PUBLIC_ENDPOINT_URL=http://localhost:5000
# Dummy credentials for moto only
AWS_ACCESS_KEY_ID=testing
AWS_SECRET_ACCESS_KEY=testing

# Uploads
UPLOAD_MAX_BYTES=52428800
PRESIGN_EXPIRES_SECONDS=600

# Build metadata (set by CI; shown on each analysis)
GIT_SHA=dev

# Frontend (Vite). Empty = same origin: Vite proxies /api to 127.0.0.1:8000 in dev, and nginx/Traefik route /api in
# Compose and Kubernetes. Set a full URL only to call an API on another origin (it must be in CORS_ALLOWED_ORIGINS).
VITE_API_BASE_URL=
